{
  "name": "@darowasahito/yla-navi",
  "description": "Ylä — navigation library",
  "displayName": "Ylä",
  "keywords": [
    "navigation",
    "javascript",
    "typescript",
    "ドロワーメニュー"
  ],
  "private": true,
  "version": "1.0.0",
  "author": "darowasahito",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/yla-bundle.min.js",
  "module": "./dist/yla-bundle.js",
  "types": "./dist/yla-bundle.d.ts",
  "exports": {
    ".": {
      "types": "./dist/yla-bundle.d.ts",
      "import": "./dist/yla-bundle.js",
      "require": "./dist/yla-bundle.min.js"
    },
    "./yla": {
      "types": "./dist/yla-bundle.d.ts",
      "require": "./dist/yla.min.js"
    },
    "./valikko": {
      "types": "./dist/yla-bundle.d.ts",
      "require": "./dist/valikko.min.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build && vite build --config vite.config.yla.umd.js && vite build --config vite.config.valikko.umd.js",
    "preview": "vite preview",
    "test": "vite --config test/vite.config.js",
    "build:test": "tsc && vite build --config test/vite.config.js"
  },
  "devDependencies": {
    "sass": "^1.81.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.5.0"
  }
}