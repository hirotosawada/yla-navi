{
  "name": "@darowasahito/yla-navi",
  "description": "Ylä — navigation library",
  "displayName": "Ylä",
  "keywords": [
    "navigation",
    "javascript",
    "typescript",
    "drawer",
    "menu",
    "ドロワーメニュー"
  ],
  "version": "2.0.0",
  "author": "darowasahito",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HirotoSawada/yla-navi.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/yla-bundle.esm.js",
    "./dist/yla-bundle.min.js",
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/yla-bundle.esm.js",
  "module": "./dist/yla-bundle.esm.js",
  "types": "./dist/yla-bundle.d.ts",
  "exports": {
    ".": {
      "types": "./dist/yla-bundle.d.ts",
      "import": "./dist/yla-bundle.esm.js"
    },
    "./yla": {
      "types": "./dist/yla.d.ts",
      "import": "./dist/yla.esm.js"
    },
    "./valikko": {
      "types": "./dist/valikko.d.ts",
      "import": "./dist/valikko.esm.js"
    },
    "./yla.css": "./dist/yla.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc && vite build && vite build --config vite.config.yla.umd.js && vite build --config vite.config.valikko.umd.js && node scripts/bundle-dts.mjs && npm run build:css",
    "build:css": "sass src/scss/yla.scss dist/yla.css --no-source-map",
    "preview": "vite preview",
    "test": "vite --config test/vite.config.js",
    "build:test": "tsc && vite build --config test/vite.config.js"
  },
  "devDependencies": {
    "sass": "^1.81.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.5.0"
  }
}